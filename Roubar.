local origHold = setmetatable({}, { __mode = "k" })
local watched  = setmetatable({}, { __mode = "k" })
local function applyInstant(p)
	if not p:IsA("ProximityPrompt") then return end
	if origHold[p] == nil then origHold[p] = p.HoldDuration end
	if Rec.InstantHold and p.HoldDuration ~= 0 then
		pcall(function() p.HoldDuration = 0 end)
	end
	if not watched[p] then
		watched[p] = true
		p:GetPropertyChangedSignal("HoldDuration"):Connect(function()
			if Rec.InstantHold and p.HoldDuration ~= 0 then
				origHold[p] = p.HoldDuration
				pcall(function() p.HoldDuration = 0 end)
			end
		end)
	end
end
local function setInstantAll(on)
	Rec.InstantHold = on
	for _, o in ipairs(workspace:GetDescendants()) do
		if o:IsA("ProximityPrompt") then
			if on then
				applyInstant(o)
			elseif origHold[o] ~= nil then
				pcall(function() o.HoldDuration = origHold[o] end)
			end
		end
	end
end
workspace.DescendantAdded:Connect(function(o)
	if o:IsA("ProximityPrompt") then
		allPrompts[o] = true
		task.defer(applyInstant, o)
	end
end)
local function resolvePrompt(evt, soHabilitado)
	local ep = Vector3.new(evt.pos.x, evt.pos.y, evt.pos.z)
	local txt = evt.actionText
	local best, bestD = nil, 6
	for o in pairs(allPrompts) do
		local par = o.Parent
		if o.Enabled and par and par:IsA("BasePart") then
			local d = (par.Position - ep).Magnitude
			if txt and txt ~= "" and o.ActionText ~= txt then d = d + 3 end
			if d < bestD then best, bestD = o, d end
		end
	end
	if best then return best end
	local p = refTo(evt.path)
	if p and p:IsA("ProximityPrompt") and p.Parent and p.Parent:IsA("BasePart")
	   and (p.Parent.Position - ep).Magnitude < 15 and (p.Enabled or not soHabilitado) then
		return p
	end
	if soHabilitado then return nil end
	local any, anyD = nil, 25
	for o in pairs(allPrompts) do
		local par = o.Parent
		if par and par:IsA("BasePart") then
			local d = (par.Position - ep).Magnitude
			if d < anyD then any, anyD = o, d end
		end
	end
	return any
end
local function firePrompt(evt, log)
	local prompt = resolvePrompt(evt)
	if not prompt then log("✗ prompt não achado"); return end
	local part = prompt.Parent
	if not part or not part:IsA("BasePart") then return end
	log("→ '" .. (prompt.ActionText or "?") .. "'")
	Rec.StopFlag = true
	local hrp = getHRP()
	if not hrp then Rec.StopFlag = false; return end
	local maxDist = prompt.MaxActivationDistance or 10
	local target
	if evt.standPos then
		local sp = Vector3.new(evt.standPos.x, evt.standPos.y, evt.standPos.z)
		if (sp - part.Position).Magnitude <= maxDist - 1 then target = sp end
	end
	if not target and (hrp.Position - part.Position).Magnitude > maxDist - 1 then
		local d = hrp.Position - part.Position
		d = Vector3.new(d.X, 0, d.Z)
		local dir = d.Magnitude > 0.5 and d.Unit or Vector3.new(1, 0, 0)
		target = part.Position + dir * math.max(3, maxDist - 3)
	end
	if target and (hrp.Position - target).Magnitude > 1 then
		teleportExact(target)
		task.wait(0.25)
	end
	hrp = getHRP()
	if not hrp then Rec.StopFlag = false; return end
	pcall(function()
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.Anchored = true
	end)
	local t1 = os.clock()
	while not prompt.Enabled and os.clock() - t1 < 2 do task.wait(0.05) end
	local holdT
	if Rec.InstantHold then
		holdT = 0.15
	else
		holdT = math.max((evt.duration or 1) / Rec.Speed, (prompt.HoldDuration or 0) + 0.15)
	end
	log("  ▶ " .. string.format("%.2fs", holdT))
	local disparou = false
	if type(fireproximityprompt) == "function" then
		local oldHold, oldLos = prompt.HoldDuration, prompt.RequiresLineOfSight
		pcall(function()
			prompt.HoldDuration = 0
			prompt.RequiresLineOfSight = false
		end)
		disparou = pcall(function() fireproximityprompt(prompt) end)
		task.wait(0.35)
		pcall(function()
			prompt.HoldDuration = oldHold
			prompt.RequiresLineOfSight = oldLos
		end)
		if disparou then log("  ✓ fireproximityprompt") end
	end
	if not disparou then
		pcall(function() prompt:InputHoldBegin() end)
		task.wait(holdT)
		pcall(function() prompt:InputHoldEnd() end)
	end
	pcall(function() hrp.Anchored = false end)
	task.wait(0.3)
	Rec.StopFlag = false
end
local function firePromptBoost(evt, log, primeiro)
	local t0 = os.clock()
	local limite = primeiro and 25 or 2.5
	local prompt = resolvePrompt(evt, true)
	if not prompt then log("  ⏳ esperando prompt aparecer...") end
	while not prompt and os.clock() - t0 < limite and Rec.State == "playing" do
		task.wait(0.1)
		prompt = resolvePrompt(evt, true)
	end
	if not prompt then log("  ✗ prompt não apareceu, pulei"); return end
	local part = prompt.Parent
	local hrp = getHRP()
	if not part or not hrp then return end
	local maxDist = prompt.MaxActivationDistance or 10
	if (hrp.Position - part.Position).Magnitude > maxDist - 1 then
		local alvo
		if evt.standPos then
			local sp = Vector3.new(evt.standPos.x, evt.standPos.y, evt.standPos.z)
			if (sp - part.Position).Magnitude <= maxDist - 1 then alvo = sp end
		end
		if not alvo then
			local d = hrp.Position - part.Position
			d = Vector3.new(d.X, 0, d.Z)
			local dir = d.Magnitude > 0.5 and d.Unit or Vector3.new(1, 0, 0)
			alvo = part.Position + dir * math.max(3, maxDist - 3)
		end
		teleportExact(alvo)
		task.wait(Rec.BoostDelay)
	end
	log("⚡ '" .. (prompt.ActionText or "?") .. "'")
	local ok = false
	if type(fireproximityprompt) == "function" then
		local oh, ol = prompt.HoldDuration, prompt.RequiresLineOfSight
		pcall(function()
			prompt.HoldDuration = 0
			prompt.RequiresLineOfSight = false
		end)
		ok = pcall(fireproximityprompt, prompt)
		task.wait(0.05)
		pcall(function()
			prompt.HoldDuration = oh
			prompt.RequiresLineOfSight = ol
		end)
	end
	if not ok then
		pcall(function() prompt.HoldDuration = 0 end)
		pcall(function() prompt:InputHoldBegin() end)
		task.wait(0.1)
		pcall(function() prompt:InputHoldEnd() end)
	end
end
local function getConns(sig)
	local ok, list = pcall(function() return getconnections(sig) end)
	if ok and type(list) == "table" then return list end
	return {}
end
local function fireConns(sig)
	local n = 0
	for _, c in ipairs(getConns(sig)) do
		local ok = pcall(function() c:Fire() end)
		if not ok then pcall(function() c.Function() end) end
		n = n + 1
	end
	return n
end
local function vimTouch(p, dur)
	if not VIM then return false end
	local ok = pcall(function() VIM:SendTouchEvent(1, 0, p.X, p.Y) end)
	if ok then
		task.wait(dur)
		pcall(function() VIM:SendTouchEvent(1, 2, p.X, p.Y) end)
	end
	return ok
end
local function vimMouse(p, dur)
	if not VIM then return false end
	local ok = pcall(function() VIM:SendMouseButtonEvent(p.X, p.Y, 0, true, game, 0) end)
	if ok then
		task.wait(dur)
		pcall(function() VIM:SendMouseButtonEvent(p.X, p.Y, 0, false, game, 0) end)
	end
	return ok
end
local function vuClick(p, dur)
	local ok = pcall(function()
		VU:CaptureController()
		VU:Button1Down(Vector2.new(p.X, p.Y))
	end)
	if ok then
		task.wait(dur)
		pcall(function()
			VU:Button1Up(Vector2.new(p.X, p.Y))
			if VU.ReleaseController then VU:ReleaseController() end
		end)
	end
	return ok
end
local METHODS = {
	{ name = "CONEXÕES", run = function(btn, dur)
		if not btn:IsA("GuiButton") then return false end
		for _, ev in ipairs({ "Activated", "MouseButton1Click" }) do
			if #getConns(btn[ev]) > 0 then
				task.wait(math.min(dur, 0.2))
				fireConns(btn[ev])
				return true
			end
		end
		if #getConns(btn.MouseButton1Down) > 0 then
			fireConns(btn.MouseButton1Down)
			task.wait(dur)
			fireConns(btn.MouseButton1Up)
			return true
		end
		return false
	end },
	{ name = "TOQUE VIM", run = function(btn, dur)
		return vimTouch(screenCenter(btn), dur)
	end },
	{ name = "MOUSE VIM", run = function(btn, dur)
