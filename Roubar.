-- ABRIR / FECHAR
local aberto = false
local function abrir()
	if aberto then return end
	aberto = true
	menu.Visible = true
	uiScale.Scale = 0
	Tween:Create(uiScale, TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1}):Play()
end
local function fecharMenu()
	if not aberto then return end
	aberto = false
	local t = Tween:Create(uiScale, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Scale = 0})
	t:Play()
	t.Completed:Connect(function() if not aberto then menu.Visible = false end end)
end
fechar.MouseButton1Click:Connect(fecharMenu)

-- LOGO: arrastar + clique
local ld = {on = false, moved = false, startInput = nil, startPos = nil}
logo.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		ld.on = true; ld.moved = false
		ld.startInput = i.Position; ld.startPos = logo.Position
	end
end)
UIS.InputChanged:Connect(function(i)
	if not ld.on then return end
	if i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch then
		local d = i.Position - ld.startInput
		if math.abs(d.X) > 4 or math.abs(d.Y) > 4 then ld.moved = true end
		logo.Position = UDim2.new(ld.startPos.X.Scale, ld.startPos.X.Offset + d.X,
								  ld.startPos.Y.Scale, ld.startPos.Y.Offset + d.Y)
	end
end)
UIS.InputEnded:Connect(function(i)
	if not ld.on then return end
	if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
		ld.on = false
		if not ld.moved then
			if aberto then fecharMenu() else abrir() end
		end
	end
end)

