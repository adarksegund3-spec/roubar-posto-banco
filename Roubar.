local function findPromptByPos(pos, radius)
	radius = radius or 25
	local best, bestDist = nil, radius
	for _, o in ipairs(workspace:GetDescendants()) do
		if o:IsA("ProximityPrompt") and o.Parent and o.Parent:IsA("BasePart") then
			local d = (o.Parent.Position - pos).Magnitude
			if d < bestDist then best, bestDist = o, d end
		end
	end
	return best
end
