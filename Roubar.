		or s:find("confirm", 1, true) or s:find("pagar", 1, true)
end
local function fireGui(evt, log, fast)
	local obj
	local t0 = os.clock()
	local maxWait = Rec.Simulate and 2.5 or 5
	repeat
		obj = acharGui(evt)
		if not obj then task.wait(0.15) end
	until obj or os.clock() - t0 > maxWait or Rec.State ~= "playing"
	if not obj then log("✗ botão não achado: " .. (evt.text or evt.name or "?")); return end
	if not esperarEstavel(obj, 3, fast and 0.1 or 0.3) then
		log("✗ botão sem tamanho/instável, pulei: " .. (evt.text or obj.Name))
		return
	end
	local c = screenCenter(obj)
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(9999, 9999)
	if c.X < 5 or c.Y < 5 or c.X > vp.X or c.Y > vp.Y or (c.X < 110 and c.Y < 70) then
		log("✗ posição suspeita (" .. math.floor(c.X) .. "," .. math.floor(c.Y) .. "), pulei")
		return
	end
	local nome = (evt.text and evt.text ~= "") and evt.text or obj.Name
	local dur = (evt.duration or 0.1) / Rec.Speed
	if dur < 0.15 then dur = 0.15 end
	if fast then dur = 0.06 end
	local buy = isBuy(evt, obj)
	log("→ '" .. nome .. "' [" .. obj.ClassName .. "] (" .. math.floor(c.X) .. "," .. math.floor(c.Y) .. ") " .. ClickModes[Rec.ClickMode])
	if Rec.Simulate then
		showDot(c, buy and Color3.fromRGB(255, 200, 40) or Color3.fromRGB(255, 60, 60))
		log("  ● SIMULADO (não clicou)")
		task.wait(1.0)
		return
	end
	if buy and not Rec.AllowBuy then
		showDot(c, Color3.fromRGB(255, 200, 40))
		log("  ⏭ COMPRAR pulado (modo seguro)")
		task.wait(0.5)
		return
	end
	if buy then
		log("  ⏳ aguardando Comprar habilitar...")
		task.wait(fast and 0.15 or 0.4)
	end
	doClick(obj, dur, log, buy)
	task.wait(fast and 0.12 or 0.45)
end
local function fireRaw(evt, log, fast)
	local dur = (evt.duration or 0.1) / Rec.Speed
	if dur < 0.1 then dur = 0.1 end
	if fast then dur = 0.05 end
	local p = Vector2.new(evt.x, evt.y) + GS:GetGuiInset()
	log("◉ toque em (" .. math.floor(evt.x) .. "," .. math.floor(evt.y) .. ")")
	if not vimTouch(p, dur) then
		if not vimMouse(p, dur) then vuClick(p, dur) end
	end
	task.wait(fast and 0.1 or 0.3)
end
local function fireTouch(evt, log, fast)
	Rec.StopFlag = true
	local hum = getHum(); local hrp = getHRP()
	if hum and hrp then hum:MoveTo(hrp.Position) end
	log("⬛ " .. (evt.partName or "?"))
	local target = Vector3.new(evt.pos.x, evt.pos.y, evt.pos.z)
	if Rec.Turbo then
		teleportTo(target); task.wait(fast and 0.15 or 0.5)
	else
		hrp = getHRP()
		local t0 = os.clock()
		while hrp and dist(hrp.Position, target) > 4 and os.clock() - t0 < 5 do
			if not Rec.StopFlag or Rec.State ~= "playing" then Rec.StopFlag = false; return end
			hum = getHum(); hrp = getHRP()
			if not hum or not hrp then break end
			hum:MoveTo(target); task.wait(0.08)
		end
		hrp = getHRP()
		if hrp and dist(hrp.Position, target) > 5 then teleportTo(target) end
		task.wait(0.5)
	end
	Rec.StopFlag = false
end
local function walkMoveTo(pos)
	if Rec.StopFlag then return end
	if Rec.Turbo then
		local hrp = getHRP()
		if hrp and dist(hrp.Position, pos) < 1.5 then return end
		teleportExact(pos)
		return
	end
	local hum = getHum()
	if hum then pcall(function() hum:MoveTo(pos) end) end
end
local function execRouteBoost(route, log)
	log("⚡ " .. route.label)
	if #route.events == 0 then log("  (vazia)"); return end
	if route.startPos then
		teleportTo(Vector3.new(route.startPos.x, route.startPos.y, route.startPos.z))
		task.wait(0.15)
	end
	local lastPos = route.startPos
	local primeiro = true
	for _, evt in ipairs(route.events) do
		if Rec.State ~= "playing" then return end
		if evt.type == "move" then
			lastPos = evt.pos
		else
			if evt.type == "prompt" then
				if lastPos then evt.standPos = lastPos end
				firePromptBoost(evt, log, primeiro)
				primeiro = false
			elseif evt.type == "gui" then
				fireGui(evt, log, true)
			elseif evt.type == "raw" then
				fireRaw(evt, log, true)
			elseif evt.type == "touch" then
				fireTouch(evt, log, true)
			end
		end
	end
end
local function execRoute(route, log)
	if Rec.Boost then return execRouteBoost(route, log) end
	log("══ " .. route.label .. " ══")
	if #route.events == 0 then log("  (vazia)"); return end
	if route.startPos then
		teleportTo(Vector3.new(route.startPos.x, route.startPos.y, route.startPos.z))
		task.wait(0.5)
	end
	local t0 = os.clock()
	local totalT = route.events[#route.events].t or 1
	local lastPos = nil
	for _, evt in ipairs(route.events) do
		if Rec.State ~= "playing" then return end
		local targetT = evt.t / Rec.Speed
		local elapsed = os.clock() - t0
		if targetT > elapsed then task.wait(targetT - elapsed) end
		if evt.type == "prompt" then
			if lastPos then evt.standPos = lastPos end
			firePrompt(evt, log)
			local drift = (os.clock() - t0) - targetT
			if drift > 0 then t0 = t0 + drift end
		elseif evt.type == "gui" then
			fireGui(evt, log)
			local drift = (os.clock() - t0) - targetT
			if drift > 0 then t0 = t0 + drift end
		elseif evt.type == "raw" then
			fireRaw(evt, log)
			local drift = (os.clock() - t0) - targetT
			if drift > 0 then t0 = t0 + drift end
		elseif evt.type == "touch" then
			fireTouch(evt, log)
			local drift = (os.clock() - t0) - targetT
			if drift > 0 then t0 = t0 + drift end
		elseif evt.type == "move" then
			lastPos = evt.pos
			walkMoveTo(Vector3.new(evt.pos.x, evt.pos.y, evt.pos.z))
		end
	end
end
local showDeliverPopup, hideDeliverPopup
local function runAll()
	if Rec.State == "playing" then return end
	local tem = false
	for _, r in ipairs(Routes) do if #r.events > 0 then tem = true; break end end
	if not tem then
		if UIRefs.setStatus then UIRefs.setStatus("Nenhuma rota carregada", Color3.fromRGB(230,90,90)) end
		return
	end
	Rec.State = "playing"; Rec.StopFlag = false
	if UIRefs.setStatus then UIRefs.setStatus("▶ Rodando", Color3.fromRGB(120,220,140)) end
	if UIRefs.clearLog then UIRefs.clearLog() end
	local log = function(s) if UIRefs.addLog then UIRefs.addLog(s) end end
	local pedirEntrega = false
	for _, route in ipairs(Routes) do
		if Rec.State ~= "playing" then break end
		if route.key ~= Cur.deliverKey then
			execRoute(route, log)
			if Rec.State ~= "playing" then break end
			if route.key == Cur.triggerKey and #route.events > 0 then pedirEntrega = true end
			task.wait(Rec.Boost and 0.05 or 0.4)
		end
	end
	if Rec.State == "playing" then
		Rec.State = "idle"
		if pedirEntrega and showDeliverPopup then
			showDeliverPopup()
			if UIRefs.setStatus then UIRefs.setStatus("⏳ Aguardando tempo de roubo", Color3.fromRGB(240,200,90)) end
		else
			if UIRefs.setStatus then UIRefs.setStatus("✓ Concluído", Color3.fromRGB(120,220,140)) end
		end
	end
end
local function runSingle(route)
	if Rec.State == "playing" then return end
	if #route.events == 0 then return end
	Rec.State = "playing"; Rec.StopFlag = false
	if UIRefs.setStatus then UIRefs.setStatus("▶ " .. route.label, Color3.fromRGB(120,220,140)) end
	if UIRefs.clearLog then UIRefs.clearLog() end
	local log = function(s) if UIRefs.addLog then UIRefs.addLog(s) end end
	execRoute(route, log)
	local completou = (Rec.State == "playing")
	Rec.State = "idle"
	if UIRefs.setStatus then UIRefs.setStatus("✓ " .. route.label .. " concluído", Color3.fromRGB(120,220,140)) end
	if route.key == Cur.triggerKey and completou and showDeliverPopup then
		showDeliverPopup()
		if UIRefs.setStatus then UIRefs.setStatus("⏳ Aguardando tempo de roubo", Color3.fromRGB(240,200,90)) end
	end
end
local function startRec(route)
	if Rec.State ~= "idle" then return end
	route.events = {}
	route.startPos = nil
	local hrp = getHRP()
	if hrp then
		route.startPos = { x = hrp.Position.X, y = hrp.Position.Y, z = hrp.Position.Z }
	end
	Rec.ActiveRoute = route
	Rec.StartTime = os.clock()
	Rec.State = "recording"
	hooks = {}; lastPromptT = 0; lastBtnT = 0; lastRawT = 0
	rawTouches = {}
	scanTudo()
	hookRawTouch()
	task.spawn(function()
		while Rec.State == "recording" do scanTudo(); task.wait(0.4) end
	end)
	startSampler()
	if UIRefs.setStatus then UIRefs.setStatus("● GRAVANDO: " .. route.label, Color3.fromRGB(230,90,90)) end
end
local function stopRec()
	if Rec.State ~= "recording" then return end
	Rec.State = "idle"
	limparConns()
	if UIRefs.setStatus then UIRefs.setStatus("Gravação parada", Color3.fromRGB(180,180,195)) end
