end
local function stopPlay()
	Rec.State = "idle"
	Rec.StopFlag = false
	if hideDeliverPopup then hideDeliverPopup() end
	local hrp = getHRP()
	if hrp then pcall(function() hrp.Anchored = false end) end
	if UIRefs.setStatus then UIRefs.setStatus("Parado", Color3.fromRGB(180,180,195)) end
end
