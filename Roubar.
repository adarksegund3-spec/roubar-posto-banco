local function hookPrompt(p)
	if hooks[p] then return end
	hooks[p] = true
	local holdT = nil
	local c1 = p.PromptButtonHoldBegan:Connect(function(plr)
		if plr ~= LP then return end
		if Rec.State ~= "recording" then return end
		holdT = os.clock()
	end)
	local c2 = p.PromptButtonHoldEnded:Connect(function(plr)
		if plr ~= LP then return end
		if Rec.State ~= "recording" then return end
		if not holdT then return end
		local dur = os.clock() - holdT
		holdT = nil
		local now = os.clock()
		if now - lastPromptT < 0.1 then return end
		lastPromptT = now
		local part = p.Parent
		local pos = part and part.Position or Vector3.new()
		addEvent({
			type = "prompt", path = refDe(p),
			pos = { x = pos.X, y = pos.Y, z = pos.Z },
			duration = dur, actionText = p.ActionText or "",
		})
	end)
	local c3 = p.Triggered:Connect(function(plr)
		if plr ~= LP then return end
		if Rec.State ~= "recording" then return end
		if holdT then return end
		local now = os.clock()
		if now - lastPromptT < 0.1 then return end
		lastPromptT = now
		local part = p.Parent
		local pos = part and part.Position or Vector3.new()
		addEvent({
			type = "prompt", path = refDe(p),
			pos = { x = pos.X, y = pos.Y, z = pos.Z },
			duration = 0.1, actionText = p.ActionText or "",
		})
	end)
	table.insert(conexoes, c1); table.insert(conexoes, c2); table.insert(conexoes, c3)
end
local function hookGuiButton(obj)
	if hooks[obj] then return end
	if isOurs(obj) then return end
	local n = obj.Name:lower()
	if n:find("thumbstick") or n:find("joystick") or n:find("touchcontrol") then return end
	local isClickable = false
	if obj:IsA("GuiButton") then
		isClickable = true
	elseif (obj:IsA("Frame") or obj:IsA("ImageLabel") or obj:IsA("TextLabel")) and obj.Active then
		isClickable = true
	end
	if not isClickable then return end
	hooks[obj] = true
	local downT = nil
	local function register()
		if Rec.State ~= "recording" then return end
		local now = os.clock()
		if now - lastBtnT < 0.1 then return end
		lastBtnT = now
		local b = resolveBtn(obj)
		local txt = ""
		if obj:IsA("TextButton") or obj:IsA("TextLabel") then
			txt = obj.Text or ""
		end
		if txt == "" and (b:IsA("TextButton") or b:IsA("TextLabel")) then
			txt = b.Text or ""
		end
		if txt == "" then
			for _, child in ipairs(b:GetChildren()) do
				if (child:IsA("TextLabel") or child:IsA("TextButton"))
				   and child.Text and child.Text ~= "" then
					txt = child.Text
					break
				end
			end
		end
		addEvent({
			type = "gui",
			path = refDe(b),
			text = txt,
			name = b.Name,
			duration = downT and (os.clock() - downT) or 0.1,
			pos = { x = b.AbsolutePosition.X, y = b.AbsolutePosition.Y },
			size = { x = b.AbsoluteSize.X, y = b.AbsoluteSize.Y },
		})
	end
	if obj:IsA("GuiButton") then
		local c1 = obj.MouseButton1Down:Connect(function()
			if Rec.State ~= "recording" then return end
			downT = os.clock()
		end)
		local c2 = obj.MouseButton1Up:Connect(function()
			if Rec.State ~= "recording" then return end
			register(); downT = nil
		end)
		local c3 = obj.MouseButton1Click:Connect(function()
			if Rec.State ~= "recording" then return end
			if downT then return end
			register()
		end)
		table.insert(conexoes, c1); table.insert(conexoes, c2); table.insert(conexoes, c3)
	end
	local c4 = obj.InputBegan:Connect(function(input)
		if Rec.State ~= "recording" then return end
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
			downT = os.clock()
		end
	end)
	local c5 = obj.InputEnded:Connect(function(input)
		if Rec.State ~= "recording" then return end
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
			register(); downT = nil
		end
	end)
	table.insert(conexoes, c4); table.insert(conexoes, c5)
end
local function hookRawTouch()
	local cBegan = UIS.InputBegan:Connect(function(input, gp)
		if gp then return end
		if Rec.State ~= "recording" then return end
		if not Rec.RawTouchEnabled then return end
		if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
			rawTouches[input] = {
				x = input.Position.X, y = input.Position.Y,
				t0 = os.clock(),
			}
		end
	end)
	local cEnded = UIS.InputEnded:Connect(function(input)
		if Rec.State ~= "recording" then return end
		local rt = rawTouches[input]
		if not rt then return end
		rawTouches[input] = nil
		local dur = os.clock() - rt.t0
		local now = os.clock()
		if now - lastRawT < 0.05 then return end
		lastRawT = now
		addEvent({
			type = "raw",
			x = rt.x, y = rt.y,
			duration = dur,
		})
	end)
	table.insert(conexoes, cBegan); table.insert(conexoes, cEnded)
end
