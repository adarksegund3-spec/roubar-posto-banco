local function startSampler()
	task.spawn(function()
		local lastPos = nil
		local lastTouched = {}
		while Rec.State == "recording" do
			local hrp = getHRP()
			local hum = getHum()
			if hrp and hum and hum.Health > 0 then
				local p = hrp.Position
				if not lastPos or (p - lastPos).Magnitude >= Rec.MinMoveDist then
					addEvent({ type = "move", pos = { x = p.X, y = p.Y, z = p.Z } })
					lastPos = p
				end
				local ok, parts = pcall(function() return hrp:GetTouchingParts() end)
				if ok and parts then
					local thisSet = {}
					for _, part in ipairs(parts) do
						thisSet[part] = true
						if not lastTouched[part] then
							local isChar = part:IsDescendantOf(LP.Character)
							local hasTT = part:FindFirstChildOfClass("TouchTransmitter") ~= nil
							local sugestivo = hasNomeSugestivo(part)
							if not isChar and (hasTT or sugestivo) then
								addEvent({
									type = "touch", path = refDe(part),
									pos = { x = part.Position.X, y = part.Position.Y, z = part.Position.Z },
									partName = part.Name,
								})
							end
						end
					end
					lastTouched = thisSet
				end
			end
			task.wait(Rec.SampleRate)
		end
	end)
end
