local function refDe(inst)
	if not inst then return nil end
	local ok, full = pcall(function() return inst:GetFullName() end)
	return ok and full or nil
end
local function refTo(path)
	if not path then return nil end
	local cur = game
	for p in path:gmatch("[^%.]+") do
		cur = cur:FindFirstChild(p)
		if not cur then return nil end
	end
	return cur
end
local function dist(a, b) return (a - b).Magnitude end
local function isOurs(btn)
	local cur = btn
	while cur do
		if cur:GetAttribute("AKZ_Own") then return true end
		cur = cur.Parent
	end
	return false
end
local function resolveBtn(o)
	local c = o
	while c and c.Parent do
		if c:IsA("GuiButton") then return c end
		if c:IsA("LayerCollector") then break end
		c = c.Parent
	end
	local d = o:FindFirstChildWhichIsA("GuiButton", true)
	if d then return d end
	return o
end
local function isShown(o)
	local c = o
	while c and c ~= game do
		if c:IsA("GuiObject") and not c.Visible then return false end
		if c:IsA("LayerCollector") and not c.Enabled then return false end
		c = c.Parent
	end
	return true
end
local function screenCenter(o)
	local p = o.AbsolutePosition + o.AbsoluteSize * 0.5
	local sg = o:FindFirstAncestorWhichIsA("ScreenGui")
	if sg and not sg.IgnoreGuiInset then
		p = p + GS:GetGuiInset()
	end
	return p
end
