local function snapshot(obj)
	local root = obj:FindFirstAncestorWhichIsA("ScreenGui") or obj
	local t, n = {}, 0
	for _, d in ipairs(root:GetDescendants()) do
		n = n + 1
		if n > 800 then break end
		if d:IsA("GuiObject") then
			local x = d.Name .. (d.Visible and "1" or "0")
			if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
				x = x .. d.Text .. tostring(d.TextColor3)
			end
			x = x .. tostring(d.BackgroundColor3) .. tostring(d.BackgroundTransparency)
			if d:IsA("ImageLabel") or d:IsA("ImageButton") then
				x = x .. tostring(d.ImageColor3) .. d.Image
			end
			t[#t + 1] = x
		elseif d:IsA("UIStroke") then
			t[#t + 1] = tostring(d.Color) .. tostring(d.Enabled)
		end
	end
	return table.concat(t, "|")
end
local function reacted(btn, before)
	if not btn.Parent or not isShown(btn) then return true end
	return snapshot(btn) ~= before
end
local function getMoneySnapshot()
	local pg = LP:FindFirstChild("PlayerGui")
	if not pg then return "" end
	local t = {}
	for _, d in ipairs(pg:GetDescendants()) do
		if (d:IsA("TextLabel") or d:IsA("TextButton")) and d.Visible then
			local txt = d.Text
			if txt and (txt:find("R$") or txt:find("$")
				or txt:lower():find("dinheiro") or txt:lower():find("money")
				or txt:lower():find("cash")) then
				t[#t + 1] = txt
			end
		end
	end
	return table.concat(t, "|")
end
local function tryMethod(i, btn, dur)
	local ok, r = pcall(METHODS[i].run, btn, dur)
	return ok and r == true
end
local function clickAuto(btn, dur, log, buy)
	local order = {}
	if Rec.Learned then table.insert(order, Rec.Learned) end
	for i = 1, #METHODS do
		if i ~= Rec.Learned then table.insert(order, i) end
	end
	local a = snapshot(btn); task.wait(0.12); local b = snapshot(btn)
	local estavel = (a == b)
	for _, i in ipairs(order) do
		if Rec.State ~= "playing" then return false end
		local beforeUI = snapshot(btn)
		local beforeMoney = getMoneySnapshot()
		if tryMethod(i, btn, dur) then
			local reagiu = false
			local t0 = os.clock()
			local maxWait = buy and 1.8 or 0.8
			while os.clock() - t0 < maxWait do
				if Rec.State ~= "playing" then break end
				if getMoneySnapshot() ~= beforeMoney then
					reagiu = true
					log("  ✓ " .. METHODS[i].name .. " (dinheiro mudou)")
					break
				end
				if reacted(btn, beforeUI) then
					reagiu = true
					log("  ✓ " .. METHODS[i].name .. " (UI reagiu)")
					break
				end
				task.wait(0.06)
			end
			if reagiu then
				if not buy then Rec.Learned = i end
				return true
			end
			if not estavel then
				log("  ✓ " .. METHODS[i].name .. " (assumido)")
				if not buy and not Rec.Guess then Rec.Guess = i end
				return true
			end
			log("  · " .. METHODS[i].name .. " sem reação, próximo")
		end
	end
	log("  ✗ nenhum método reagiu")
	return false
end
local function doClick(btn, dur, log, buy)
	local m = Rec.ClickMode
	if m == 1 then return clickAuto(btn, dur, log, buy) end
	local mt = METHODS[m - 1]
	if not mt then return false end
	if tryMethod(m - 1, btn, dur) then return true end
	log("  ✗ " .. mt.name .. " indisponível")
	return false
end
local function acharGui(evt)
	local obj = refTo(evt.path)
	if obj and obj.Parent and isShown(obj) then return resolveBtn(obj) end
	local pg = LP:FindFirstChild("PlayerGui")
	if not pg then return nil end
	if evt.text and evt.text ~= "" then
		for _, d in ipairs(pg:GetDescendants()) do
			if d:IsA("TextButton") and d.Text == evt.text
			   and not isOurs(d) and isShown(d) then
				return d
			end
		end
		for _, d in ipairs(pg:GetDescendants()) do
			if d:IsA("TextLabel") and d.Text == evt.text
			   and not isOurs(d) and isShown(d) then
				return resolveBtn(d)
			end
		end
	end
	if evt.name then
		for _, d in ipairs(pg:GetDescendants()) do
			if d.Name == evt.name and d:IsA("GuiObject") and not isOurs(d) and isShown(d) then
				return resolveBtn(d)
			end
		end
	end
	return nil
end
local function esperarEstavel(obj, maxT, stab)
	local t0 = os.clock()
	local lastP, lastS, since
	while os.clock() - t0 < maxT do
		if not obj.Parent then return false end
		local p, s = obj.AbsolutePosition, obj.AbsoluteSize
		if s.X > 2 and s.Y > 2 and isShown(obj) then
			if lastP and (p - lastP).Magnitude < 1 and (s - lastS).Magnitude < 1 then
				since = since or os.clock()
				if os.clock() - since >= (stab or 0.3) then return true end
			else
				since = nil
			end
		else
			since = nil
		end
		lastP, lastS = p, s
		task.wait(0.05)
	end
	return false
end
